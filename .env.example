# Core
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripcopilot?schema=public
DEV_AUTH_BYPASS=true
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_TRAVELER_ID=00000000-0000-0000-0000-000000000002

# Clerk (production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_EXTRACTION_POLICY_VERSION=engineering-v1
OPENAI_EXTRACTION_THRESHOLD=0.90

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tripcopilot

# Channel webhooks (production)
EMAIL_INGESTION_WEBHOOK_SECRET=
WHATSAPP_INGESTION_WEBHOOK_SECRET=

# Optional notification adapter
NOTIFICATION_WEBHOOK_URL=
